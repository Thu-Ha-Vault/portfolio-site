---
// Topics of the Second Brain drawn as stained cells: size = number of notes, dots = notes, lines = cross-topic links.
import graph from '../data/graph.json';
import { topicNames } from '../i18n';

const W = 560, H = 470, cx = 270, cy = 222;
const nodes = graph.nodes.filter((n) => n.notes > 0);
const radius = (n: number) => 16 + Math.sqrt(n) * 3.3;
const slots = [[0, 0], [-0.82, -0.62], [0.86, -0.5], [0.95, 0.62], [-0.9, 0.58], [0.05, 0.98], [-0.2, -1.0]];
function rng(seed: string) {
  let h = 2166136261;
  for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return ((h ^= h >>> 16) >>> 0) / 4294967296;
  };
}
const placed = nodes.slice(0, slots.length).map((n, i) => {
  const r = radius(n.notes);
  const [sx, sy] = slots[i];
  const x = cx + sx * 190, y = cy + sy * 150;
  const rand = rng(n.topic);
  const dots = Array.from({ length: Math.min(n.notes, 70) }, () => {
    const a = rand() * Math.PI * 2, d = Math.sqrt(rand()) * (r - 7);
    return { x: x + Math.cos(a) * d, y: y + Math.sin(a) * d, r: 1.6 + rand() * 1.8 };
  });
  const [vi, en] = topicNames[n.topic] ?? [n.title, n.title];
  return { ...n, x, y, r, dots, vi, en };
});
const at = Object.fromEntries(placed.map((p) => [p.topic, p]));
const edges = graph.edges
  .filter((e) => at[e.a] && at[e.b])
  .map((e) => {
    const a = at[e.a], b = at[e.b];
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
    const qx = mx + (cy - my) * 0.25, qy = my + (mx - cx) * 0.25;
    return { d: `M${a.x.toFixed(1)},${a.y.toFixed(1)} Q${qx.toFixed(1)},${qy.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`, w: 1 + Math.log2(e.weight + 1) };
  });
const total = nodes.reduce((s, n) => s + n.notes, 0);
---
<figure class="map-figure">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={`Knowledge map: ${total} notes in ${nodes.length} topics`}>
    {edges.map((e) => <path class="map-edge" d={e.d} stroke-width={e.w} />)}
    {placed.map((p) => (
      <a class="map-node" href={p.url} aria-label={`${p.en}: ${p.notes} notes`}>
        <circle class="cell" cx={p.x} cy={p.y} r={p.r} />
        {p.dots.map((d) => <circle class="nucleus" cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.r.toFixed(1)} />)}
        <text class="label" x={p.x} y={p.y + p.r + 20} text-anchor="middle"><tspan data-vi={p.vi} data-en={p.en}>{p.vi}</tspan></text>
        <text class="count" x={p.x} y={p.y + p.r + 38} text-anchor="middle">{p.notes}</text>
      </a>
    ))}
  </svg>
  <figcaption><slot /></figcaption>
</figure>
