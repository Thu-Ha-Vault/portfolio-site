---
// The Second Brain drawn as a brain: each topic is a region with a hub, dots are notes (neurons),
// thin lines are dendrites inside a topic, pink arcs are links between topics.
import graph from '../data/graph.json';
import { topicNames } from '../i18n';

const W = 560, H = 430;

function rng(seed: string) {
  let h = 2166136261;
  for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return ((h ^= h >>> 16) >>> 0) / 4294967296;
  };
}
type P = [number, number];
// bumpy contour so the edge reads as gyri; bottom flattened like the underside of the cerebrum
function contour(cx: number, cy: number, rx: number, ry: number, bumps: number, amp: number, floor?: number, n = 200) {
  const pts: P[] = [];
  for (let i = 0; i < n; i++) {
    const t = (i / n) * Math.PI * 2;
    const k = 1 + amp * Math.sin(bumps * t) + amp * 0.5 * Math.sin(bumps * 2.3 * t + 1);
    const x = cx + rx * Math.cos(t) * k;
    let y = cy + ry * Math.sin(t) * k;
    if (floor !== undefined && y > floor) y = floor + (y - floor) * 0.3;
    pts.push([x, y]);
  }
  return pts;
}
const toPath = (pts: P[]) => 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L') + 'Z';
const inside = (poly: P[], px: number, py: number) => {
  let c = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, yi] = poly[i], [xj, yj] = poly[j];
    if (yi > py !== yj > py && px < ((xj - xi) * (py - yi)) / (yj - yi) + xi) c = !c;
  }
  return c;
};
function folds(poly: P[], count: number, seed: string, len: number) {
  const rand = rng(seed);
  const xs = poly.map((p) => p[0]), ys = poly.map((p) => p[1]);
  const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
  const out: string[] = [];
  for (let tries = 0; out.length < count && tries < 3000; tries++) {
    let x = x0 + rand() * (x1 - x0), y = y0 + rand() * (y1 - y0);
    if (!inside(poly, x, y)) continue;
    let a = rand() * Math.PI * 2, d = `M${x.toFixed(1)},${y.toFixed(1)}`, steps = 0;
    for (let k = 0; k < 4; k++) {
      a += (rand() - 0.5) * 2.2;
      const qx = x + Math.cos(a) * len * 0.6, qy = y + Math.sin(a) * len * 0.6;
      a += (rand() - 0.5) * 2.2;
      const nx = qx + Math.cos(a) * len * 0.6, ny = qy + Math.sin(a) * len * 0.6;
      if (!inside(poly, qx, qy) || !inside(poly, nx, ny)) break;
      d += `Q${qx.toFixed(1)},${qy.toFixed(1)} ${nx.toFixed(1)},${ny.toFixed(1)}`;
      x = nx; y = ny; steps++;
    }
    if (steps >= 2) out.push(d);
  }
  return out;
}

const cerebrum = contour(300, 172, 212, 132, 14, 0.032, 262);
const cerebellum = contour(438, 318, 60, 36, 9, 0.05);
const CEREBRUM = toPath(cerebrum), CEREBELLUM = toPath(cerebellum);
const STEM = 'M352 270C360 310 362 350 360 410L394 410C391 360 389 320 386 286Z';
const GYRI = folds(cerebrum, 34, 'cortex', 13);
const FOLIA = [0, 1, 2, 3].map((i) => `M${388 + i * 4},${300 + i * 11} Q438,${292 + i * 11} ${490 - i * 4},${302 + i * 11}`);

const lobes: Record<string, { x: number; y: number; part: 'cerebrum' | 'cerebellum'; label: 'above' | 'below' }> = {
  biology: { x: 322, y: 128, part: 'cerebrum', label: 'above' },
  french: { x: 170, y: 142, part: 'cerebrum', label: 'above' },
  'ai-development': { x: 438, y: 196, part: 'cerebrum', label: 'above' },
  business: { x: 300, y: 236, part: 'cerebrum', label: 'below' },
  'university-courses': { x: 160, y: 222, part: 'cerebrum', label: 'below' },
  english: { x: 438, y: 318, part: 'cerebellum', label: 'below' },
};
const spare = [
  { x: 240, y: 190, part: 'cerebrum' as const, label: 'below' as const },
  { x: 390, y: 140, part: 'cerebrum' as const, label: 'above' as const },
];

const nodes = graph.nodes.filter((n) => n.notes > 0);
let sp = 0;
const hubs = nodes.map((n) => ({ ...n, ...(lobes[n.topic] ?? spare[sp++ % spare.length]) }));
const regions = hubs.map((h) => {
  const rand = rng(h.topic);
  const R = 26 + Math.sqrt(h.notes) * 4.6;
  const poly = h.part === 'cerebellum' ? cerebellum : cerebrum;
  const others = hubs.filter((o) => o !== h && o.part === h.part);
  const dots: { x: number; y: number; r: number }[] = [];
  const want = Math.min(h.notes, 48);
  for (let tries = 0; dots.length < want && tries < 5000; tries++) {
    const a = rand() * Math.PI * 2, d = Math.sqrt(rand()) * R;
    const x = h.x + Math.cos(a) * d, y = h.y + Math.sin(a) * d * 0.85;
    if (!inside(poly, x, y)) continue;
    const own = Math.hypot(x - h.x, y - h.y) / Math.sqrt(h.notes + 4);
    if (others.some((o) => Math.hypot(x - o.x, y - o.y) / Math.sqrt(o.notes + 4) < own)) continue;
    if (dots.some((p) => Math.hypot(p.x - x, p.y - y) < 7)) continue;
    dots.push({ x, y, r: 1.6 + rand() * 1.6 });
  }
  const sorted = [...dots].sort((a, b) => Math.hypot(a.x - h.x, a.y - h.y) - Math.hypot(b.x - h.x, b.y - h.y));
  const lines = sorted.map((p, i) => {
    let best = { x: h.x, y: h.y }, bd = Math.hypot(p.x - h.x, p.y - h.y);
    for (let j = 0; j < i; j++) {
      const q = sorted[j], dd = Math.hypot(p.x - q.x, p.y - q.y);
      if (dd < bd) { bd = dd; best = q; }
    }
    return { x1: p.x, y1: p.y, x2: best.x, y2: best.y };
  });
  const [vi, en] = topicNames[h.topic] ?? [h.title, h.title];
  return { ...h, dots, lines, vi, en };
});
const at = Object.fromEntries(regions.map((r) => [r.topic, r]));
const axons = graph.edges
  .filter((e) => at[e.a] && at[e.b])
  .map((e) => {
    const a = at[e.a], b = at[e.b];
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2 - Math.hypot(a.x - b.x, a.y - b.y) * 0.22;
    return { d: `M${a.x},${a.y} Q${mx.toFixed(1)},${my.toFixed(1)} ${b.x},${b.y}`, w: 1.2 + Math.log2(e.weight + 1) * 0.9 };
  });
const total = nodes.reduce((n, x) => n + x.notes, 0);
const f = (n: number) => n.toFixed(1);
---
<figure class="map-figure">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={`Knowledge map shaped like a brain: ${total} notes in ${nodes.length} topics`}>
    <g class="brain" aria-hidden="true">
      <path class="brain-stem" d={STEM} />
      <path class="brain-shape" d={CEREBELLUM} />
      <path class="brain-shape" d={CEREBRUM} />
      {GYRI.map((d) => <path class="sulcus" d={d} />)}
      {FOLIA.map((d) => <path class="sulcus" d={d} />)}
    </g>
    {axons.map((x) => <path class="axon" d={x.d} stroke-width={x.w} />)}
    {regions.map((r) => (
      <a class="region" href={r.url} aria-label={`${r.en}: ${r.notes} notes`}>
        <circle class="hit" cx={r.x} cy={r.y} r={30 + Math.sqrt(r.notes) * 3} />
        {r.lines.map((l) => <line class="dendrite" x1={f(l.x1)} y1={f(l.y1)} x2={f(l.x2)} y2={f(l.y2)} />)}
        {r.dots.map((d) => <circle class="neuron" cx={f(d.x)} cy={f(d.y)} r={f(d.r)} />)}
        <circle class="hub-ring" cx={r.x} cy={r.y} r="10" />
        <circle class="hub" cx={r.x} cy={r.y} r="5" />
        <text class="label" x={r.x} y={r.label === 'above' ? r.y - 18 : r.y + 26} text-anchor="middle"><tspan data-vi={r.vi} data-en={r.en}>{r.vi}</tspan> <tspan class="count">{r.notes}</tspan></text>
      </a>
    ))}
  </svg>
  <figcaption><slot /></figcaption>
</figure>
