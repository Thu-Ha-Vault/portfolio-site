---
/**
 * PhaseTrack (spec §5, motion #13): Ask → Act as one continuous iris spectrum.
 * Each bar's fill is the bar-wide slice `--i` of a gradient `--steps` bars wide, clipped to the done share
 * (`--fill`), so the done parts read as one spectrum across the track.
 * Bars are full in the HTML. The script adds `.will-fill` only when IntersectionObserver exists and motion is
 * allowed, then `.is-filled` once the track is 40% visible, so no-JS and reduced motion both show full bars.
 */
import T from './T.astro';
interface Props { phases: { name: string; done: number; total: number }[]; class?: string }
const { phases, class: cls } = Astro.props;
const done = phases.reduce((s, p) => s + p.done, 0);
const total = phases.reduce((s, p) => s + p.total, 0);
const share = (p: { done: number; total: number }) => (p.total ? Math.min(1, Math.max(0, p.done / p.total)) : 0);
---
{phases.length > 0 && (
  <div class:list={['phase-track', cls]}>
    <p class="track-label"><T k="progress" />: <span class="num">{done}/{total}</span></p>
    <ol class="track" style={`--steps: ${phases.length}`}>
      {phases.map((p, i) => (
        <li style={`--i: ${i}`} title={`${p.name}: ${p.done}/${p.total}`}>
          <span class="bar" aria-hidden="true"><span class="fill" style={`--fill: ${share(p).toFixed(3)}`}></span></span>
          <span class="name">{p.name}</span>
          <span class="count">{p.done}/{p.total}</span>
        </li>
      ))}
    </ol>
  </div>
)}

<script>
  const tracks = document.querySelectorAll<HTMLElement>('.track');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  if (tracks.length && 'IntersectionObserver' in window && !calm.matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-filled');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.4 },
    );
    for (const t of tracks) {
      // Only animate tracks that start below the fold; ones already on screen stay full (no flash on load).
      const r = t.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) continue;
      t.classList.add('will-fill');
      io.observe(t);
    }
    // Turning reduced motion on mid-visit fills every pending track at once.
    calm.addEventListener('change', () => {
      if (!calm.matches) return;
      for (const t of tracks) t.classList.add('is-filled');
      io.disconnect();
    });
  }
</script>
