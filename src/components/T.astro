---
/** A UI string in both languages. The page's own language is rendered; Base.astro swaps the text when the toggle changes it. */
import { ui, isEnglishPath, type UiKey } from '../i18n';
interface Props { k?: UiKey; vi?: string; en?: string }
const { k, vi: viProp, en: enProp } = Astro.props;
const [vi, en] = k ? ui[k] : [viProp ?? '', enProp ?? viProp ?? ''];
---
<span data-vi={vi} data-en={en}>{isEnglishPath(Astro.url.pathname) ? en : vi}</span>
