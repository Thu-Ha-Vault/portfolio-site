---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/core.css';
import '../styles/prose.css';
import '../styles/galaxy.css';
import '../styles/brutal.css';
import '../styles/cta.css';
import T from '../components/T.astro';
import Vesicles from '../components/Vesicles.astro';
import { ui } from '../i18n';
import { topicCss } from '../data/topics';
import config from '../../site.config.json';

interface Props {
  title?: string;
  description?: string;
  mermaid?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Reading page (blog post, topic page, project note): adds body.is-reading and the light-reading toggle. */
  reading?: boolean;
  /** Home page: no vesicle backdrop, masthead frosts only after the hero sentinel. Defaults to path === '/'. */
  home?: boolean;
  /** Social image path (site-relative). Defaults to the home OG image generated by the covers step. */
  image?: string;
  /** Alt text for the social image. */
  imageAlt?: string;
  /** Long-form page that is not a reading page (project root pages): the page glow stays in the top-left corner, never behind the column. */
  quietGlow?: boolean;
}
const { title, description, mermaid = false, type = 'website', jsonLd, reading = false, image, imageAlt, quietGlow = false } = Astro.props;
const path = Astro.url.pathname;
const home = Astro.props.home ?? path === '/';
const fullTitle = title ? `${title} | ${config.author.name}` : `${config.author.name} | ${config.author.headline_en}`;
const desc = description || config.author.bio_en;
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? '/og/home.png', Astro.site);
const nav = [
  { href: '/projects/', k: 'projects' as const },
  { href: '/blog/', k: 'blog' as const },
  { href: '/topics/', k: 'topics' as const },
];
const links = Object.entries(config.author.links).filter(([, v]) => v) as [string, string][];
const label: Record<string, string> = { github: 'GitHub', kaggle: 'Kaggle', linkedin: 'LinkedIn', tableau: 'Tableau Public', email: 'Email' };
// 24×24 glyphs for the footer icon squares. `fill` icons are filled, the rest are stroked.
const icons: Record<string, { d: string; fill?: boolean }> = {
  github: {
    fill: true,
    d: 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.43.37.82 1.1.82 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3',
  },
  linkedin: {
    fill: true,
    d: 'M4 9h3.5v11H4zM5.75 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h3.4v1.6c.5-.9 1.7-1.9 3.5-1.9 3.6 0 4.1 2.3 4.1 5.4V20h-3.5v-5.1c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H10z',
  },
  kaggle: { d: 'M7 3.5v17M17.5 4.5 9.5 12l8.5 8' },
  tableau: { d: 'M12 3v7M8.5 6.5h7M12 14v7M8.5 17.5h7M5.5 9v6M2.5 12h6M18.5 9v6M15.5 12h6' },
  email: { d: 'M3.5 5.5h17v13h-17zM3.5 6l8.5 7 8.5-7' },
  rss: {
    fill: true,
    d: 'M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z',
  },
};
const ctaHref = `${config.cta.url}?${config.cta.utm}&utm_campaign=footer`;
const [readVi, readEn] = ui.readingLight;
---
<!doctype html>
<html lang="vi" data-reading-page={reading ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10052e" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? config.author.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={config.author.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? config.author.name} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${config.author.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/noto-serif-display-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/be-vietnam-pro-regular.woff2" as="font" type="font/woff2" crossorigin />
    <Fragment set:html={`<style>${topicCss()}</style>`} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          // The old site stored theme=light|dark. The site is dark-only now, so drop it.
          localStorage.removeItem('theme');
          var l = localStorage.getItem('lang');
          if (l === 'en' || l === 'vi') d.lang = l;
          if (d.hasAttribute('data-reading-page') && localStorage.getItem('reading') === 'light') d.dataset.reading = 'light';
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={{ 'is-reading': reading, 'is-home': home, 'is-quiet': quietGlow && !reading }}>
    <a class="skip" href="#main"><T k="skip" /></a>
    {!home && (
      <div class="vesicle-layer" aria-hidden="true"><Vesicles /></div>
    )}
    <header class:list={['masthead', { 'is-frosted': !home }]} data-masthead>
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/" aria-label={`${config.author.name}, ${ui.home[0]}`} data-aria-vi={`${config.author.name}, ${ui.home[0]}`} data-aria-en={`${config.author.name}, ${ui.home[1]}`}>{config.author.name}</a>
        <nav class="nav" aria-label={ui.mainNav[0]} data-aria-vi={ui.mainNav[0]} data-aria-en={ui.mainNav[1]}>
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}><T k={n.k} /></a>
          ))}
        </nav>
        <div class="toggles">
          {reading && (
            <button class="toggle toggle-reading" id="reading-toggle" type="button" aria-pressed="false">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="3.6" fill="currentColor" /><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              <span class="toggle-text"><span data-vi={readVi} data-en={readEn}>{readVi}</span></span>
            </button>
          )}
          {/* The accessible name is the visible word (WCAG 2.5.3), spoken in its own language. */}
          <button class="toggle" id="lang-toggle" type="button">
            <span lang="en" data-vi="English" data-en="Tiếng Việt" data-lang-vi="en" data-lang-en="vi">English</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="colophon">
      <div class="wrap colophon-inner">
        <div class="colophon-find">
          <span><T k="findMe" /></span>
          <ul class="icon-squares">
            {links.map(([k, v]) => (
              <li>
                <a class="icon-square" href={k === 'email' ? `mailto:${v}` : v} rel={k === 'email' ? undefined : 'me noopener'} aria-label={label[k] ?? k} title={label[k] ?? k}>
                  {icons[k] ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill={icons[k].fill ? 'currentColor' : 'none'} stroke={icons[k].fill ? undefined : 'currentColor'} stroke-width={icons[k].fill ? undefined : '1.8'} stroke-linecap="round" stroke-linejoin="round"><path d={icons[k].d} /></svg>
                  ) : (
                    <span aria-hidden="true">{(label[k] ?? k).slice(0, 1)}</span>
                  )}
                </a>
              </li>
            ))}
            <li>
              <a class="icon-square" href="/rss.xml" aria-label="RSS" title="RSS">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={icons.rss.d} /></svg>
              </a>
            </li>
          </ul>
        </div>
        <p class="colophon-line">
          <span><T k="footer" /></span>
          <a href={ctaHref}>CEOVANTA</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply(lang) {
          root.lang = lang;
          document.querySelectorAll('[data-vi]').forEach(function (el) {
            var v = el.getAttribute('data-' + lang);
            if (v != null) el.textContent = v;
          });
          document.querySelectorAll('[data-placeholder-vi]').forEach(function (el) {
            el.setAttribute('placeholder', el.getAttribute('data-placeholder-' + lang));
          });
          document.querySelectorAll('[data-aria-vi]').forEach(function (el) {
            var v = el.getAttribute('data-aria-' + lang);
            if (v != null) el.setAttribute('aria-label', v);
          });
          document.querySelectorAll('[data-title-vi]').forEach(function (el) {
            var v = el.getAttribute('data-title-' + lang);
            if (v != null) el.setAttribute('title', v);
          });
          document.querySelectorAll('[data-alt-vi]').forEach(function (el) {
            var v = el.getAttribute('data-alt-' + lang);
            if (v != null) el.setAttribute('alt', v);
          });
          document.querySelectorAll('[data-lang-vi]').forEach(function (el) {
            var v = el.getAttribute('data-lang-' + lang);
            if (v != null) el.setAttribute('lang', v);
          });
        }
        apply(root.lang === 'en' ? 'en' : 'vi');
        document.getElementById('lang-toggle').addEventListener('click', function () {
          var next = root.lang === 'en' ? 'vi' : 'en';
          try { localStorage.setItem('lang', next); } catch (e) {}
          apply(next);
        });

        // Light reading toggle (reading pages only).
        var rt = document.getElementById('reading-toggle');
        if (rt) {
          var sync = function () { rt.setAttribute('aria-pressed', root.dataset.reading === 'light' ? 'true' : 'false'); };
          sync();
          rt.addEventListener('click', function () {
            var light = root.dataset.reading !== 'light';
            if (light) root.dataset.reading = 'light'; else delete root.dataset.reading;
            try { if (light) localStorage.setItem('reading', 'light'); else localStorage.removeItem('reading'); } catch (e) {}
            sync();
            document.dispatchEvent(new CustomEvent('readingchange', { detail: { light: light } }));
          });
        }

        // Header frost (motion #9). Home: the bar is clear only while the page sits at the very top, so the canvas
        // runs under a clear header at scrollY 0, and frosts as soon as any hero content would pass under it.
        // The sentinel is the first 8px of the stage; IntersectionObserver also catches jump scrolls.
        var mh = document.querySelector('[data-masthead]');
        var sentinel = document.querySelector('.hero-sentinel');
        if (mh && !mh.classList.contains('is-frosted')) {
          if (sentinel && 'IntersectionObserver' in window) {
            new IntersectionObserver(function (entries) {
              mh.classList.toggle('is-frosted', !entries[entries.length - 1].isIntersecting);
            }).observe(sentinel);
          } else {
            mh.classList.add('is-frosted');
          }
        }
        // The hero runs under the header by exactly its height (two rows on phones).
        if (mh && 'ResizeObserver' in window) {
          new ResizeObserver(function () { root.style.setProperty('--masthead-h', mh.offsetHeight + 'px'); }).observe(mh);
        }

        // Wide content in the reading column (spec §6). Tables show a static right-edge fade while they can still
        // scroll sideways; an inline KaTeX formula wider than its line becomes its own small scroller (.is-wide).
        // Anything that actually scrolls is a keyboard stop (tabindex 0); anything that fits is not.
        // Performance: one batched pass (all reads, then all writes), scheduled in an animation frame after the
        // fonts load, and re-run only when the column width changes (height changes are ignored, so toggling
        // .is-wide cannot feed back into the ResizeObserver). KaTeX only breaks lines between its .base boxes, so a
        // formula overflows exactly when one .base is wider than the line box.
        var prose = document.querySelector('.prose');
        if (prose) {
          var tables = Array.prototype.slice.call(prose.querySelectorAll('.table-scroll'));
          var displays = Array.prototype.slice.call(prose.querySelectorAll('.katex-display'));
          var maths = Array.prototype.filter.call(prose.querySelectorAll('.katex'), function (k) { return !k.closest('.katex-display'); });
          var boxes = maths.map(function (k) { return k.parentElement && k.parentElement.closest('p, li, dd, td, th, blockquote, figcaption, div'); });
          var widest = function (k) {
            var w = 0;
            var bs = k.querySelectorAll('.katex-html > .base');
            if (!bs.length) return k.getBoundingClientRect().width;
            for (var j = 0; j < bs.length; j++) w = Math.max(w, bs[j].getBoundingClientRect().width);
            return w;
          };
          var focusable = function (el, on, label) {
            if (on) {
              el.setAttribute('tabindex', '0');
              if (label) { el.setAttribute('role', 'region'); el.setAttribute('aria-label', el.getAttribute('data-aria-' + (root.lang === 'en' ? 'en' : 'vi')) || label); }
            } else {
              el.removeAttribute('tabindex');
              if (label) { el.removeAttribute('role'); el.removeAttribute('aria-label'); }
            }
          };
          var pass = function () {
            // reads
            var natural = maths.map(widest);
            var room = boxes.map(function (b) { return b ? b.clientWidth : Infinity; });
            var tOver = tables.map(function (el) { return [el.scrollWidth > el.clientWidth + 1, el.scrollLeft + el.clientWidth >= el.scrollWidth - 1]; });
            var dOver = displays.map(function (el) { return el.scrollWidth > el.clientWidth + 1; });
            // writes
            maths.forEach(function (k, i) {
              var wide = natural[i] > room[i] + 1;
              if (wide !== k.classList.contains('is-wide')) k.classList.toggle('is-wide', wide);
              focusable(k, wide);
            });
            tables.forEach(function (el, i) {
              el.classList.toggle('has-overflow', tOver[i][0]);
              el.classList.toggle('at-end', tOver[i][0] && tOver[i][1]);
              focusable(el, tOver[i][0], 'table');
            });
            displays.forEach(function (el, i) { focusable(el, dOver[i]); });
          };
          var queued = 0;
          var schedule = function () { if (!queued) queued = requestAnimationFrame(function () { queued = 0; pass(); }); };
          tables.forEach(function (el) {
            el.addEventListener('scroll', function () {
              el.classList.toggle('at-end', el.scrollLeft + el.clientWidth >= el.scrollWidth - 1);
            }, { passive: true });
          });
          if (tables.length || maths.length || displays.length) {
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedule);
            else schedule();
            var lastW = -1;
            if ('ResizeObserver' in window) {
              new ResizeObserver(function (es) {
                var w = Math.round(es[es.length - 1].contentRect.width);
                if (w === lastW) return;
                var first = lastW < 0;
                lastW = w;
                if (!first) schedule();
              }).observe(prose);
            } else window.addEventListener('resize', schedule);
          }
        }
      })();
    </script>
    {mermaid && (
      <script type="module" is:inline>
        // Performance: mermaid is large, so it is downloaded only when a diagram comes near the viewport.
        let mermaid = null;
        // Keep the source in data-src so the diagrams can re-render when light reading toggles.
        // mermaid is in excludeLangs (astro.config.mjs), so it arrives as <pre><code class="language-mermaid">.
        document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid').forEach((el) => {
          const pre = el.closest('pre');
          if (!pre || !pre.isConnected) return;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.dataset.src = pre.textContent;
          div.textContent = pre.textContent;
          pre.replaceWith(div);
        });
        const themeVariables = () => {
          const cs = getComputedStyle(document.body);
          const v = (n, f) => cs.getPropertyValue(n).trim() || f;
          const light = document.documentElement.dataset.reading === 'light' && document.body.classList.contains('is-reading');
          return {
            darkMode: !light,
            background: v('--deep', '#1a0b45'),
            primaryColor: v('--raise', '#251258'),
            primaryTextColor: v('--ink', '#ede9fc'),
            primaryBorderColor: v('--edge', '#7466b0'),
            secondaryColor: v('--deep', '#1a0b45'),
            tertiaryColor: v('--deep', '#1a0b45'),
            lineColor: v('--ink-soft', '#b9b1d8'),
            textColor: v('--ink', '#ede9fc'),
            mainBkg: v('--raise', '#251258'),
            nodeBorder: v('--edge', '#7466b0'),
            clusterBkg: v('--deep', '#1a0b45'),
            edgeLabelBackground: v('--deep', '#1a0b45'),
            fontFamily: "'Be Vietnam Pro', system-ui, sans-serif",
          };
        };
        const render = async () => {
          const nodes = [...document.querySelectorAll('.mermaid[data-src]')];
          if (!nodes.length) return;
          if (!mermaid) mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs')).default;
          nodes.forEach((n) => { n.removeAttribute('data-processed'); n.textContent = n.dataset.src; });
          // Natural size, not squeezed to the column: a wide LR flowchart keeps readable labels and scrolls
          // sideways inside .mermaid (overflow-x: auto), which becomes a named keyboard stop while it overflows.
          const natural = { useMaxWidth: false };
          mermaid.initialize({
            startOnLoad: false, theme: 'base', themeVariables: themeVariables(),
            flowchart: natural, sequence: natural, gantt: natural, class: natural, state: natural, er: natural,
            journey: natural, timeline: natural, mindmap: natural, pie: natural, gitGraph: natural, requirement: natural,
          });
          try { await mermaid.run({ nodes }); } catch (e) { console.warn('mermaid', e); }
          const en = document.documentElement.lang === 'en';
          nodes.forEach((n) => {
            if (n.scrollWidth > n.clientWidth + 1) {
              n.setAttribute('tabindex', '0');
              n.setAttribute('role', 'region');
              n.setAttribute('data-aria-vi', 'Sơ đồ (cuộn ngang)');
              n.setAttribute('data-aria-en', 'Diagram (scrolls sideways)');
              n.setAttribute('aria-label', en ? 'Diagram (scrolls sideways)' : 'Sơ đồ (cuộn ngang)');
            } else {
              ['tabindex', 'role', 'aria-label'].forEach((a) => n.removeAttribute(a));
            }
          });
        };
        const diagrams = document.querySelectorAll('.mermaid[data-src]');
        if (diagrams.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((es) => {
            if (es.some((e) => e.isIntersecting)) { io.disconnect(); render(); }
          }, { rootMargin: '800px 0px' });
          diagrams.forEach((n) => io.observe(n));
        } else render();
        document.addEventListener('readingchange', () => { if (mermaid) render(); });
      </script>
    )}
  </body>
</html>
