---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { blogEntries, childrenOf, siblings, breadcrumbs, hasMermaid } from '../../lib';

export async function getStaticPaths() {
  const all = await blogEntries();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const kids = d.isIndex ? childrenOf(all, entry.id) : [];
const { prev, next } = siblings(all, entry);
const crumbs = breadcrumbs(all, entry.id);
---
<Base title={d.title} description={d.description} mermaid={hasMermaid(entry.body)}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/blog/"><T k="blog" /></a>
    {crumbs.map((c) => (<><span>/</span><a href={`/blog/${c.id}/`}>{c.title}</a></>))}
  </nav>
  <header class="article-head">
    <h1>{d.title}</h1>
    <div class="meta">
      {d.tags.slice(0, 6).map((t) => <span class="tag">{t}</span>)}
      {d.source && <a href={d.source} target="_blank" rel="noopener"><T k="source" /> ↗</a>}
    </div>
  </header>
  <article class="prose"><Content /></article>
  {kids.length > 0 && (
    <section class="children">
      <h2><T k="inThisSection" /></h2>
      <ul class="note-list">
        {kids.map((k) => (
          <li><a href={`/blog/${k.id}/`}><span class={k.data.isIndex ? 'folder-link' : ''}>{k.data.isIndex ? '▸ ' : ''}{k.data.title}</span></a></li>
        ))}
      </ul>
    </section>
  )}
  {(prev || next) && (
    <nav class="pager">
      {prev && <a href={`/blog/${prev.id}/`}><small><T k="prev" /></small>{prev.data.title}</a>}
      {next && <a class="next" href={`/blog/${next.id}/`}><small><T k="next" /></small>{next.data.title}</a>}
    </nav>
  )}
</Base>
