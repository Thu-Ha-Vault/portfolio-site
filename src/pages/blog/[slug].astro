---
import Article from '../../layouts/Article.astro';
import { blogEntries, param } from '../../lib';

export async function getStaticPaths() {
  const all = await blogEntries();
  return all.filter((e) => !e.data.isIndex).map((entry) => ({ params: { slug: param(entry.data.url) }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
---
<Article entry={entry} all={all} />
