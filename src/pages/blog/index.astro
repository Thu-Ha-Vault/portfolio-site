---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import PostRows from '../../components/PostRows.astro';
import { blogEntries, byUpdated } from '../../lib';
import { topicNames, ui } from '../../i18n';

const blog = await blogEntries();
const posts = blog.filter((e) => !e.data.isIndex).sort(byUpdated);
const topics = [...new Set(posts.map((p) => p.data.topic ?? ''))]
  .map((t) => ({ t, n: posts.filter((p) => p.data.topic === t).length }))
  .sort((a, b) => b.n - a.n);
---
<Base title="Blog" description="Notes on biology, data science, AI, business and languages, written while learning.">
  <div class="wrap">
    <header class="page-head">
      <h1><T k="blog" /></h1>
      <p><T k="blogIntro" /></p>
    </header>
    <div class="filters" role="group" aria-label="Topics">
      <button type="button" aria-pressed="true" data-filter=""><T k="allTopics" /> {posts.length}</button>
      {topics.map(({ t, n }) => {
        const [vi, en] = topicNames[t] ?? [t, t];
        return <button type="button" aria-pressed="false" data-filter={t}><span data-vi={vi} data-en={en}>{vi}</span> {n}</button>;
      })}
    </div>
    <label class="search-label" for="q"><T k="search" /></label>
    <input class="search" id="q" type="search" autocomplete="off" placeholder={ui.searchPlaceholder[0]} data-placeholder-vi={ui.searchPlaceholder[0]} data-placeholder-en={ui.searchPlaceholder[1]} />
    <p class="result-count" id="count" aria-live="polite">{posts.length}</p>
    <PostRows posts={posts} id="posts" filterable />
    <p class="empty" id="empty" hidden><T k="noResults" /></p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var items = Array.prototype.slice.call(document.querySelectorAll('#posts li'));
      var empty = document.getElementById('empty');
      var count = document.getElementById('count');
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
      var topic = '';
      var norm = function (s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd'); };
      items.forEach(function (li) { li.dataset.n = norm(li.dataset.q || ''); });
      function run() {
        var words = norm(q.value.toLowerCase().trim()).split(/\s+/).filter(Boolean);
        var shown = 0;
        items.forEach(function (li) {
          var ok = (!topic || li.dataset.topic === topic) && words.every(function (w) { return li.dataset.n.indexOf(w) !== -1; });
          li.hidden = !ok;
          if (ok) shown++;
        });
        empty.hidden = shown > 0;
        count.textContent = shown;
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          topic = b.dataset.filter;
          buttons.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          run();
        });
      });
      q.addEventListener('input', run);
      var t = new URLSearchParams(location.search).get('topic');
      if (t) { var b = buttons.find(function (x) { return x.dataset.filter === t; }); if (b) b.click(); }
    })();
  </script>
</Base>
