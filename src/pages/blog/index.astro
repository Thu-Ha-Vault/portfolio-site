---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { blogEntries } from '../../lib';
import { sectionNames, ui } from '../../i18n';

const blog = await blogEntries();
const sections = blog.filter((e) => e.data.isIndex && !e.id.includes('/'));
const notes = blog.filter((e) => !e.data.isIndex);
const countIn = (id: string) => notes.filter((e) => e.id.startsWith(id + '/')).length;
---
<Base title="Blog" description="Notes on biology, data science, AI, business and languages, synced from an Obsidian Second Brain.">
  <p class="eyebrow"><T k="blog" /></p>
  <h1><T vi="Kiến thức từ Second Brain" en="Notes from my Second Brain" /></h1>
  <p class="lead"><T vi="Ghi chép từ các khoá học, sách và sổ tay của mình, sắp xếp theo chủ đề." en="Notes from courses, books and notebooks, organized by topic." /></p>

  <h2 class="section-title"><T k="topics" /></h2>
  <div class="grid">
    {sections.map((s) => {
      const name = sectionNames[s.data.section ?? ''] ?? [s.data.title, s.data.title];
      return (
        <a class="card" href={`/blog/${s.id}/`}>
          <h3><T vi={name[0]} en={name[1]} /></h3>
          <div class="meta"><span class="count">{countIn(s.id)}</span> <T k="notes" /></div>
        </a>
      );
    })}
  </div>

  <input class="search" id="q" type="search" placeholder={ui.search[0]} data-placeholder-vi={ui.search[0]} data-placeholder-en={ui.search[1]} aria-label="Search" />
  <ul class="note-list" id="notes">
    {notes.map((n) => (
      <li data-q={`${n.data.title} ${n.data.folder ?? ''} ${n.data.tags.join(' ')}`.toLowerCase()}>
        <a href={`/blog/${n.id}/`}><span>{n.data.title}</span><span class="where">{n.data.folder}</span></a>
      </li>
    ))}
  </ul>
  <p id="empty" hidden><T k="noResults" /></p>
  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var items = Array.prototype.slice.call(document.querySelectorAll('#notes li'));
      var empty = document.getElementById('empty');
      var norm = function (s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd'); };
      items.forEach(function (li) { li.dataset.n = norm(li.dataset.q); });
      q.addEventListener('input', function () {
        var words = norm(q.value.toLowerCase().trim()).split(/\s+/).filter(Boolean);
        var shown = 0;
        items.forEach(function (li) {
          var ok = words.every(function (w) { return li.dataset.n.indexOf(w) !== -1; });
          li.hidden = !ok;
          if (ok) shown++;
        });
        empty.hidden = shown > 0;
      });
    })();
  </script>
</Base>
