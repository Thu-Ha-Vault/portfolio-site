---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { blogEntries, childrenOf } from '../../lib';
import { topicNames } from '../../i18n';
import { glyphSvg, topicVar } from '../../data/topics';
import { ogUrl } from '../../lib/cover';

const blog = await blogEntries();
const top = blog.filter((e) => e.data.isIndex && !e.id.includes('/'));
const countIn = (id: string) => blog.filter((e) => e.id.startsWith(id + '/') && !e.data.isIndex).length;
const sorted = top.filter((t) => countIn(t.id) > 0).sort((a, b) => countIn(b.id) - countIn(a.id));
---
<Base title="Topics" description="All notes organized by course and subject." image={ogUrl('/topics/')}>
  <div class="wrap page-head">
    <h1><T k="topics" /></h1>
    <p><T k="topicsIntro" /></p>
  </div>
  <div class="wrap list-page">
    <div class="topic-tree">
      {sorted.map((t) => {
        const [vi, en] = topicNames[t.data.topic ?? ''] ?? [t.data.title, t.data.title];
        const subs = childrenOf(blog, t.id).filter((c) => c.data.isIndex && countIn(c.id) > 0);
        return (
          <section class="topic-group" style={`--tc:${topicVar(t.data.topic)}`}>
            <h2>
              <a href={t.data.url}>
                <Fragment set:html={glyphSvg(t.data.topic, 28, 1.3)} />
                <span data-vi={vi} data-en={en}>{vi}</span>
              </a>
            </h2>
            <p class="topic-count"><span class="num">{countIn(t.id)}</span> <T k="notes" /></p>
            {subs.length > 0 && (
              <ul class="rows topic-rows">
                {subs.map((s) => (
                  <li><a href={s.data.url}><span class="t">{s.data.title}</span><span class="where num">{countIn(s.id)}</span></a></li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Base>
