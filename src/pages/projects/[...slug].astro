---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import PhaseTrack from '../../components/PhaseTrack.astro';
import ShareBar from '../../components/ShareBar.astro';
import Cta from '../../components/Cta.astro';
import { projectEntries, siblings, breadcrumbs, hasMermaid, statusKey, fmtDate, param } from '../../lib';

export async function getStaticPaths() {
  const all = await projectEntries();
  return all.map((entry) => ({ params: { slug: param(entry.data.url) }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const kids = d.isIndex ? all.filter((e) => e.data.project === d.project && !e.data.isIndex) : [];
const { prev, next } = siblings(all, entry);
const crumbs = breadcrumbs(all, entry.id);
const s = statusKey(d.status);
const url = new URL(d.url, Astro.site).toString();
const linkLabel: Record<string, string> = { github: 'GitHub', kaggle: 'Kaggle', tableau: 'Tableau Public', demo: 'Demo', slides: 'Slides' };
---
<Base title={d.title} description={d.description} mermaid={hasMermaid(entry.body)} type="article">
  <div class="wrap article">
    <ol class="crumbs">
      <li><a href="/projects/"><T k="projects" /></a></li>
      {crumbs.map((c) => <li><a href={c.url}>{c.title}</a></li>)}
    </ol>
    <header class={`article-head${d.isIndex ? ' brutal' : ''}`}>
      <h1>{d.title}</h1>
      <p class="byline">
        {s && <span class="status"><T k={s} /></span>}
        {d.deadline && <span><T k="due" /> {fmtDate(d.deadline)}</span>}
        {d.updated && <span><T k="updated" /> {fmtDate(d.updated)}</span>}
      </p>
      {d.isIndex && d.phases.length > 0 && <div class="brutal" style="margin-top:28px;max-width:44rem"><PhaseTrack phases={d.phases} /></div>}
      {d.isIndex && Object.keys(d.links).length > 0 && (
        <div class="actions brutal" style="margin-top:24px">
          {Object.entries(d.links).map(([k, v]) => <a class="button" href={v} rel="noopener">{linkLabel[k] ?? k}</a>)}
        </div>
      )}
    </header>
    <article class="prose"><Content /></article>
    <div class="after">
      {kids.length > 0 && (
        <section class="children brutal">
          <h2><T k="projectNotes" /></h2>
          <ul class="rows">{kids.map((k) => <li><a href={k.data.url}><span class="t">{k.data.title}</span></a></li>)}</ul>
        </section>
      )}
      {(prev || next) && (
        <nav class="pager" aria-label="Pagination">
          {prev && <a href={prev.data.url}><small><T k="prev" /></small>{prev.data.title}</a>}
          {next && <a class="next" href={next.data.url}><small><T k="next" /></small>{next.data.title}</a>}
        </nav>
      )}
      <ShareBar url={url} title={d.title} />
      <Cta campaign={`project_${d.project}`} />
    </div>
  </div>
</Base>
