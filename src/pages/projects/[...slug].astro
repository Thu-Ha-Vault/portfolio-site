---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Cover from '../../components/Cover.astro';
import PhaseTrack from '../../components/PhaseTrack.astro';
import ShareBar from '../../components/ShareBar.astro';
import Cta from '../../components/Cta.astro';
import { projectEntries, siblings, breadcrumbs, hasMermaid, statusKey, fmtDate, param } from '../../lib';
import { ogUrl } from '../../lib/cover';
import { ui } from '../../i18n';
import { coverSize, realCover } from './_helpers';

export async function getStaticPaths() {
  const all = await projectEntries();
  return all.map((entry) => ({ params: { slug: param(entry.data.url) }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const kids = d.isIndex ? all.filter((e) => e.data.project === d.project && !e.data.isIndex) : [];
const { prev, next } = siblings(all, entry);
const crumbs = breadcrumbs(all, entry.id);
const s = statusKey(d.status);
const url = new URL(d.url, Astro.site).toString();
const linkLabel: Record<string, string> = { github: 'GitHub', kaggle: 'Kaggle', tableau: 'Tableau Public', demo: 'Demo', slides: 'Slides', certificate: 'Certificate' };
const links = Object.entries(d.links).filter(([, v]) => v);
// Project index pages get the brutal head with the cover; project notes are reading pages (light reading toggle).
const real = d.isIndex ? realCover(d.cover) : undefined;
const size = real ? await coverSize(real.src) : undefined;
---
<Base title={d.title} description={d.description} mermaid={hasMermaid(entry.body)} type="article" reading={!d.isIndex} quietGlow={d.isIndex} image={ogUrl(d.url)}>
  <div class="wrap article">
    {d.isIndex ? (
      <Fragment>
      <nav class="crumbs-nav" aria-label={ui.crumbs[0]} data-aria-vi={ui.crumbs[0]} data-aria-en={ui.crumbs[1]}>
        <ol class="crumbs">
          <li><a href="/projects/"><T k="projects" /></a></li>
          {crumbs.map((c) => <li><a href={c.url}>{c.title}</a></li>)}
        </ol>
      </nav>
      <header class="article-head brutal project-head">
        <div class="project-head-text">
          <h1>{d.title}</h1>
          <p class="byline">
            {s && <span class="status" data-status={s}><T k={s} /></span>}
            {d.deadline && <span><T k="due" /> {fmtDate(d.deadline)}</span>}
            {d.updated && <span><T k="updated" /> {fmtDate(d.updated)}</span>}
          </p>
        </div>
        <figure class="case-cover project-cover">
          {real ? (
            <Cover src={real.src} width={size?.w} height={size?.h} alt="" loading="eager" />
          ) : (
            <Cover entry={entry} loading="eager" />
          )}
          <figcaption>{real ? <T vi={real.alt} en={real.alt_en ?? real.alt} /> : <T vi="Minh hoạ" en="Illustration" />}</figcaption>
        </figure>
        {d.phases.length > 0 && <PhaseTrack phases={d.phases} class="head-track" />}
        {links.length > 0 && (
          <div class="actions head-actions">
            {links.map(([k, v]) => <a class="button" href={v} rel="noopener">{linkLabel[k] ?? k}</a>)}
          </div>
        )}
      </header>
      </Fragment>
    ) : (
      <div class="post-top">
        <Cover entry={entry} class="post-cover" loading="eager" fetchpriority="high" />
        <nav class="crumbs-nav" aria-label={ui.crumbs[0]} data-aria-vi={ui.crumbs[0]} data-aria-en={ui.crumbs[1]}>
          <ol class="crumbs">
            <li><a href="/projects/"><T k="projects" /></a></li>
            {crumbs.map((c) => <li><a href={c.url}>{c.title}</a></li>)}
          </ol>
        </nav>
        <header class="article-head">
          <h1>{d.title}</h1>
          <p class="byline">
            {s && <span class="status" data-status={s}><T k={s} /></span>}
            {d.deadline && <span><T k="due" /> {fmtDate(d.deadline)}</span>}
            {d.updated && <span><T k="updated" /> {fmtDate(d.updated)}</span>}
          </p>
        </header>
      </div>
    )}
    <article class="prose"><Content /></article>
    <div class="after">
      {kids.length > 0 && (
        <section class="children brutal">
          <h2><T k="projectNotes" /></h2>
          <ul class="rows">{kids.map((k) => <li><a href={k.data.url}><span class="t">{k.data.title}</span></a></li>)}</ul>
        </section>
      )}
      {(prev || next) && (
        <nav class="pager" aria-label="Bài trước và bài sau" data-aria-vi="Bài trước và bài sau" data-aria-en="Previous and next">
          {prev && <a class="prev" href={prev.data.url}><small><T k="prev" /></small><span>{prev.data.title}</span></a>}
          {next && <a class="next" href={next.data.url}><small><T k="next" /></small><span>{next.data.title}</span></a>}
        </nav>
      )}
      <ShareBar url={url} title={d.title} />
      <Cta campaign={`project_${d.project}`} />
    </div>
  </div>
</Base>
