---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { projectEntries, statusKey } from '../../lib';

const all = await projectEntries();
const projects = all
  .filter((p) => p.data.isIndex)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.date ?? '').localeCompare(a.data.date ?? ''));
---
<Base title="Projects">
  <p class="eyebrow"><T k="projects" /></p>
  <h1><T k="allProjects" /></h1>
  <div class="grid" style="margin-top:24px">
    {projects.map((p) => {
      const s = statusKey(p.data.status);
      const n = all.filter((e) => e.data.project === p.data.project && !e.data.isIndex).length;
      return (
        <a class="card" href={`/projects/${p.id}/`}>
          <h3>{p.data.title}</h3>
          {p.data.description && <p>{p.data.description}</p>}
          <div class="meta">
            {s && <span class="badge"><T k={s} /></span>}
            {p.data.date && <span>{p.data.date}</span>}
            {n > 0 && <span>· {n} <T k="notes" /></span>}
          </div>
        </a>
      );
    })}
  </div>
</Base>
