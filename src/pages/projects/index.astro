---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import ProjectCase from '../../components/ProjectCase.astro';
import { projectEntries } from '../../lib';
import { ogUrl } from '../../lib/cover';

const projects = (await projectEntries())
  .filter((p) => p.data.isIndex)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (a.data.deadline ?? '9999').localeCompare(b.data.deadline ?? '9999'));
---
<Base title="Projects" description="Data analysis case studies and learning projects, tracked from Ask to Act." image={ogUrl('/projects/')}>
  <div class="wrap brutal projects-page">
    <header class="page-head brutal-head">
      <h1><T k="projects" /></h1>
      <p><T k="projectsIntro" /></p>
    </header>
    <div class="case-list">
      {projects.map((p) => <ProjectCase project={p} heading="h2" />)}
    </div>
  </div>
</Base>
